rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Firebase 콘솔에서 members/{사용자UID} 문서를 직접 등록한 계정만 허용합니다.
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function validSchedule(scheduleId) {
      return request.resource.data.keys().hasOnly([
          'id', 'title', 'start', 'end', 'category', 'note', 'done', 'flag'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'title', 'start', 'end', 'category', 'note', 'done', 'flag'
        ])
        && request.resource.data.id == scheduleId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.start is string
        && request.resource.data.start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.end is string
        && request.resource.data.end.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.start <= request.resource.data.end
        && request.resource.data.category is string
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 5000
        && request.resource.data.done is bool
        && request.resource.data.flag is string;
    }

    match /schedules/{scheduleId} {
      allow read, delete: if isMember();
      allow create, update: if isMember() && validSchedule(scheduleId);
    }

    match /members/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // 관리자는 Firebase 콘솔에서만 추가/수정
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
